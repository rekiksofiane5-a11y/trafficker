{
  // Version 100 % navigateur (offre gratuite) : site statique servi par Cloudflare.
  // Le moteur Python tourne dans le navigateur (Pyodide) ; aucun conteneur.
  // Version serveur (Containers, offre payante) : wrangler.containers.jsonc.
  "name": "trafficker",
  "main": "web/worker.js",
  "compatibility_date": "2026-06-01",
  "build": { "command": "python3 web/build.py" },
  "assets": { "directory": "./web/dist", "binding": "ASSETS" },
  // Surveillance des campagnes (alertes cloche + e-mail) : toutes les 6 heures
  "triggers": { "crons": ["17 */6 * * *"] },
  // Comptes, sessions et tâches partagées par agence (D1, offre gratuite)
  "d1_databases": [
    { "binding": "DB", "database_name": "trafficker", "database_id": "4dcc9fc7-6fad-4557-8612-296e8a8f06ab" }
  ],
  // v1 a créé la classe du conteneur lors d'un premier essai ; v2 la supprime
  // (le Worker gratuit n'en a pas besoin). Pour revenir à la version serveur,
  // ajouter une migration v3 qui la recrée dans wrangler.containers.jsonc.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TraffickerContainer"] },
    { "tag": "v2", "deleted_classes": ["TraffickerContainer"] }
  ]
}
