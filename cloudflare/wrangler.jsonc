{
  // Déploiement de l'UI Trafficker sur Cloudflare Containers (offre Workers payante).
  "name": "trafficker",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "containers": [
    {
      "class_name": "TraffickerContainer",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "TraffickerContainer", "name": "TRAFFICKER" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TraffickerContainer"] }],
  "observability": { "enabled": true }
}
