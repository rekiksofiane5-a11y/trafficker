/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'
/app/pyodide/*
  Cache-Control: public, max-age=604800
/app/py/*
  Cache-Control: no-cache
/app/index.html
  Cache-Control: no-cache
/app/engine.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/app/
  Cache-Control: no-cache
